# Application
APP_BASE_URL=http://localhost:3000
APP_ENV=development
# auto uses Firestore when Firebase Admin is configured, otherwise placeholders.
# Set firestore in staging/production so missing credentials fail closed.
CATALOGUE_DATA_SOURCE=auto

SESSION_COOKIE_NAME=bridgegate_session
SESSION_MAX_AGE_SECONDS=432000

# Firebase server configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Firebase web application configuration (public by design)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false

# Firebase local emulators (local development only; never set on Vercel)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Transactional email
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO_ADDRESS=

# Fulfilment notification gateways (server-only HTTPS adapters)
# Channels remain disabled in Firestore settings until approved.
NOTIFICATION_EMAIL_GATEWAY_URL=
NOTIFICATION_EMAIL_GATEWAY_TOKEN=
NOTIFICATION_SMS_GATEWAY_URL=
NOTIFICATION_SMS_GATEWAY_TOKEN=

# Scheduled jobs
# Vercel automatically sends CRON_SECRET as a Bearer token.
# Use at least 16 random characters and configure a scheduler interval that
# is shorter than the checkout reservation lifetime.
CRON_SECRET=
# Optional alias for a non-Vercel scheduler.
CRON_AUTH_SECRET=
